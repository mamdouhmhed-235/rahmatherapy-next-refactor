# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/audit-screenshots

# next.js
/.next/
/.open-next/
/out/
/dist/
/.dist-parity-dev/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log
phase*.log
phase*.out.log
phase*.err.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env

# typescript
*.tsbuildinfo
next-env.d.ts
cloudflare-env.d.ts

# Claude Code / Impeccable skill / Playwright MCP — per-machine runtime artifacts
.claude/launch.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
.impeccable/
.playwright-mcp/

# Superpowers brainstorming skill + Kilo Code extension runtime state
.superpowers/
redesign/.kilo/

# C-21 visual-regression screenshots — 24.6 MB of full-page PNGs, ~3x the size of
# every other tracked evidence image combined. The findings live in
# redesign/evidence/C-21/visual-regression-1280.md, which is tracked.
redesign/evidence/C-21/*.png

# Playwright run artifacts — regenerated by every run.
test-results/

# The Owner's source photo inbox: 55 MB of camera originals staged for import
# into public/images/, which is where the site actually serves them from. 28 of
# its 52 files already existed there byte-identically, and nothing in src/ or
# public/ loaded from this path — it was working material, not a site asset.
# MOVED OUT of the repo on 2026-08-17 to ~/Desktop/rahma-archive-2026-08-17/
# (all 52 files, because 24 of them exist nowhere else). The rule is kept so the
# directory cannot reappear untracked by accident.
photos-rahma-therapy/

# Installer archive for the impeccable skill. Its 61 entries are byte-identical
# to the already-tracked .claude/skills/impeccable/, so committing it would
# duplicate 284 KB. It was untracked AND unignored until 2026-08-17, i.e. one
# `git add .` away from a public repo.
.claude/skills/impeccable.zip

# Production-readiness audit workspace (local only)
.production-readiness/

# Supabase CLI scratch state — written by any `supabase`/MCP call (e.g. the
# read-only list_migrations used in the 2026-08-17 audit). Regenerable, and it
# otherwise breaks the documented `git status --porcelain -- src/ supabase/`
# gate, which must stay EMPTY.
supabase/.temp/

# ⛔ Live Supabase session cookies minted for the browser-test role agents.
# NEVER commit: each file is a working login for one role identity.
e2e/.auth/

# Agent handoff notes (local only)
handoff/

# Audit working artifacts — raw DOM dumps and full-page screenshots from the
# admin UI audit runs. `raw/` alone is 988MB / ~4,500 files, and staging it
# produced 21,635 files and 38.6 MILLION insertions.
#
# ⛔ NEVER COMMIT THESE. This repository is PUBLIC, and the captures include
# full-page screenshots of /admin/audit — the one screen that still displays
# deleted clients names, emails, phone numbers and home addresses, because
# audit rows may never be deleted. They are evidence for a point-in-time
# review, not source, and they do not belong in a public history.
#
# ⚠️ EVERY capture directory, not just `raw/` — there are a dozen (raw-v2,
# raw-after, raw-therapist-seeded, ...) and they carry the same content.
redesign/admin-ui-audit/raw*/
redesign/admin-ui-audit/canary/
redesign/admin-ui-audit/digest/
redesign/admin-ui-audit/findings/
redesign/admin-ui-audit/review/
redesign/admin-ui-audit/seed/
redesign/admin-ui-audit/reference/

# Scratch artifacts from audit/verification runs — measurement JSON, crop and
# mask PNGs, one-off .mjs helpers, per-commit dumps. All `_`-prefixed by
# convention. Working notes, not source; regenerate them rather than commit them.
redesign/admin-ui-audit/_*
