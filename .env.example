
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=lanternvale
SENTRY_PROJECT=rahmatherapy-next-refactor

# App
NEXT_PUBLIC_SITE_URL=https://yourdomain.co.uk

# Google Analytics (GA4) — measurement ID, public/build-time only. Gated to
# production builds by src/components/GoogleAnalytics.tsx; unset or non-prod
# renders nothing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps / Places (address autocomplete on both booking forms). Like every
# NEXT_PUBLIC_* value this is inlined into the client bundles at BUILD time, so
# it is public by nature — any visitor can read it in devtools. Secrecy is not
# the control; restriction in the Google Cloud Console is:
#   - HTTP referrers: https://rahmatherapy.uk/*, https://*.rahmatherapy.uk/*,
#     http://localhost:3000/*
#   - APIs: Maps JavaScript API + Places API only
# Set it in the Cloudflare BUILD environment too, not just at runtime. Leave it
# unset and the address field degrades to a plain, fully usable text input.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key

# Cron (booking-reminders daily trigger — shared secret between the Worker's
# scheduled() handler and the /api/cron/booking-reminders route). Set the same
# value in Cloudflare Worker secrets at deploy time via:
#   npx wrangler secret put CRON_SECRET --env production
CRON_SECRET=replace-with-long-random-string

# Cloudflare (used by wrangler CLI during deploy - not read at runtime by Next.js)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# E2E test credentials (Playwright — e2e/helpers.ts getCredentials()/loginAs()).
# Real values belong in an UNTRACKED .env.e2e, never here — this file is the
# one tracked env file (.gitignore: `.env*` + `!.env.example`), so real
# credentials placed here would be committed. Names only, below.
#
# playwright.config.ts loads no env file itself; it only reads
# process.env.E2E_BASE_URL directly. Creating .env.e2e alone does NOT get
# these variables into the Playwright process. dotenv is not installed and
# must not be added (a package install) — Node 24 supports --env-file
# natively, so run role/contrast specs as:
#   node --env-file=.env.e2e ./node_modules/playwright/cli.js test e2e/admin-contrast.spec.ts
#
# No agent may read, echo, log, type into a form, or commit a real value for
# any of these — the harness signs in via Supabase; agents reference
# getCredentials(prefix) only.
E2E_BASE_URL=http://localhost:3000
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_COORDINATOR_EMAIL=
E2E_COORDINATOR_PASSWORD=
E2E_THERAPIST_A_EMAIL=
E2E_THERAPIST_A_PASSWORD=
E2E_THERAPIST_B_EMAIL=
E2E_THERAPIST_B_PASSWORD=
E2E_REPORTING_EMAIL=
E2E_REPORTING_PASSWORD=
# Optional — negative-case role checks (e2e/admin-roles.spec.ts) skip
# cleanly when these are absent:
E2E_INACTIVE_EMAIL=
E2E_INACTIVE_PASSWORD=
E2E_NON_STAFF_EMAIL=
E2E_NON_STAFF_PASSWORD=
